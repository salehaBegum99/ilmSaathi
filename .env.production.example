# Production template only. Store real values in the hosting platform's secret manager.
# API runtime
NODE_ENV=production
PORT=4000
WEB_URL=
API_URL=
CORS_ORIGINS=
TRUST_PROXY=true

# Managed MongoDB replica set (TLS/SRV URI, least-privilege application user)
MONGODB_URI=
MONGODB_DB_NAME=ilmsaathi
MONGODB_CONNECT_MAX_ATTEMPTS=8
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_RETRY_BASE_DELAY_MS=400
MONGODB_AUTO_INDEX=false

# Authentication and data protection
JWT_ACCESS_SECRET=
JWT_ISSUER=ilmsaathi-api
JWT_AUDIENCE=ilmsaathi-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CSRF_SECRET=
AUDIT_HMAC_SECRET=
MFA_ENCRYPTION_KEY_BASE64=
MFA_ISSUER=IlmSaathi
MFA_MAX_AGE_SECONDS=43200
BCRYPT_ROUNDS=12
CURRENT_TERMS_VERSION=
CURRENT_PRIVACY_VERSION=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=learn.example.com  # Omit for the safer host-only default.
SHUTDOWN_GRACE_MS=10000

# Abuse controls
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300
MAX_UPLOAD_BYTES=5242880

# Email and payments
EMAIL_FROM=
RESEND_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# API monitoring and analytics
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com

# Web build-time values. Every VITE_* value is public in the browser bundle.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=IlmSaathi
VITE_DEMO_MODE=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# CI/build-only; do not inject into the browser runtime.
SENTRY_AUTH_TOKEN=
