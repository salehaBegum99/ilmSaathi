# Application
APP_NAME=IlmSaathi
NODE_ENV=development
LOG_LEVEL=debug
WEB_PORT=5173
API_PORT=4000
PORT=4000
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# MongoDB - generated locally; replace MONGODB_URI in hosted environments
MONGO_PORT=27017
MONGO_NATIVE_PORT=27018
MONGO_DATABASE=ilmsaathi
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_REPLICA_SET_KEY=
MONGODB_URI=
MONGODB_URI_DOCKER=
MONGODB_DB_NAME=ilmsaathi
MONGODB_CONNECT_MAX_ATTEMPTS=8
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_RETRY_BASE_DELAY_MS=400
MONGODB_AUTO_INDEX=true

# Authentication and data protection - generated locally
JWT_ACCESS_SECRET=
JWT_ISSUER=ilmsaathi-api
JWT_AUDIENCE=ilmsaathi-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CSRF_SECRET=
AUDIT_HMAC_SECRET=
MFA_ENCRYPTION_KEY_BASE64=
MFA_ISSUER=IlmSaathi
MFA_MAX_AGE_SECONDS=43200
BCRYPT_ROUNDS=12
CURRENT_TERMS_VERSION=2026-08-29
CURRENT_PRIVACY_VERSION=2026-08-29
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SHUTDOWN_GRACE_MS=10000

# Abuse controls
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300
MAX_UPLOAD_BYTES=5242880

# Email
EMAIL_FROM=
RESEND_API_KEY=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Monitoring and privacy-conscious analytics
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Browser-exposed values (never put secrets in VITE_* variables)
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=IlmSaathi
VITE_DEMO_MODE=false
